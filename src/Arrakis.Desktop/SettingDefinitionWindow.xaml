<Window x:Class="Arrakis.Desktop.SettingDefinitionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Title}" Width="740" Height="780" MinWidth="620" MinHeight="560" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
 <Window.Resources><Style x:Key="FieldIssue" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
  <Style x:Key="EditableMetadataCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="IsEditable" Value="True"/><Setter Property="IsTextSearchEnabled" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5"/>
    <ToggleButton HorizontalAlignment="Right" Width="28" Focusable="False" Content="⌄" Foreground="{StaticResource TextBrush}" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"/>
    <TextBox x:Name="PART_EditableTextBox" Text="{Binding Text,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0" MinHeight="0" Padding="0" Margin="10,6,32,6" VerticalContentAlignment="Center" AutomationProperties.Name="Editable metadata choice"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Purpose}" Style="{StaticResource MutedText}"/><TextBlock Text="Local annotations are user/community supplied; they do not establish game defaults." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/><TextBlock Text="{Binding IdentityCaption}" Visibility="{Binding MetadataOnly,Converter={StaticResource BoolVisibility}}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,10">
   <StackPanel Visibility="{Binding IsAdding,Converter={StaticResource BoolVisibility}}"><TextBlock Text="1 · Where the game reads this variable" Foreground="{StaticResource AccentBrush}" Margin="0,6"/>
   <TextBlock Text="Configuration file"/><TextBox Text="{Binding File,Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Variable configuration file"/><TextBlock Text="Uses the active supported file. To target another file, close this window and select it in the editor." Style="{StaticResource MutedText}" FontSize="12"/>
   <TextBlock Text="INI section" Margin="0,10,0,4"/><ComboBox x:Name="SectionPicker" Style="{StaticResource EditableMetadataCombo}" IsEnabled="{Binding IdentityEditable}" ItemsSource="{Binding Sections}" Text="{Binding Section,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Variable INI section"/>
   <CheckBox Content="Advanced: allow creating a new INI section" IsChecked="{Binding AllowNewSection}" IsEnabled="{Binding IdentityEditable}"/><TextBlock Text="{Binding SectionExplanation}" Style="{StaticResource MutedText}" FontSize="12"/>
   <TextBlock Text="Exact variable key" Margin="0,10,0,4"/><TextBox x:Name="KeyInput" Text="{Binding Key,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding MetadataOnly}" AutomationProperties.Name="Variable exact key"/>
   </StackPanel><TextBlock Text="Friendly organization" Foreground="{StaticResource AccentBrush}" Margin="0,14,0,6"/>
   <TextBlock Text="Friendly display name"/><DockPanel><Button Content="Suggest" Command="{Binding SuggestNameCommand}" DockPanel.Dock="Right" Padding="10,4"/><TextBox x:Name="FriendlyInput" Text="{Binding FriendlyName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Variable friendly name"/></DockPanel>
   <TextBlock Text="Visual category" Margin="0,8,0,4"/><ComboBox x:Name="DefinitionCategory" Style="{StaticResource EditableMetadataCombo}" ItemsSource="{Binding Categories}" Text="{Binding Category,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Variable visual category"/><TextBlock Text="Choose or type a category. Categories organize Arrakis; they do not create INI sections." Style="{StaticResource MutedText}" FontSize="12"/>
   <TextBlock Text="Description (optional; do not include secrets)" Margin="0,8,0,4"/><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" MaxHeight="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Variable description"/>
   <TextBlock Text="Confirm its value type" Foreground="{StaticResource AccentBrush}" Margin="0,14,0,6"/>
   <ComboBox x:Name="TypePicker" ItemsSource="{Binding Types}" SelectedItem="{Binding Kind}" AutomationProperties.Name="Variable value type"/><TextBlock Text="{Binding TypeHelp}" Style="{StaticResource MutedText}" FontSize="12"/>
   <StackPanel Visibility="{Binding IsAdding,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Initial draft value" Margin="0,8,0,4"/><TextBox x:Name="InitialValue" Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsTextValue,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Variable initial value"/><ComboBox x:Name="BooleanValue" ItemsSource="{Binding BooleanValues}" SelectedItem="{Binding Value}" Visibility="{Binding IsBoolean,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Variable Boolean value"/><ComboBox ItemsSource="{Binding ChoiceValues}" SelectedItem="{Binding Value}" Visibility="{Binding IsChoice,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Variable choice value"/></StackPanel>
   <TextBlock Text="{Binding InitialValueError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12"/><Expander x:Name="AdvancedMetadata" Header="Advanced metadata · optional" Margin="0,14,0,0"><StackPanel>
    <StackPanel Visibility="{Binding IsNumeric,Converter={StaticResource BoolVisibility}}">
     <TextBlock Text="Minimum (Optional)" Margin="0,8,0,4"/><TextBox Text="{Binding Minimum,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Variable minimum"/><TextBlock Text="{Binding MinimumError}" Style="{StaticResource FieldIssue}"/>
     <TextBlock Text="Maximum (Optional)"/><TextBox Text="{Binding Maximum,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Variable maximum"/><TextBlock Text="{Binding MaximumError}" Style="{StaticResource FieldIssue}"/>
     <TextBlock Text="Slider Step (Optional)"/><TextBox Text="{Binding Step,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Variable step"/><TextBlock Text="{Binding StepError}" Style="{StaticResource FieldIssue}"/>
     <TextBlock Text="User-defined bounds and slider precision; blank means unspecified." Style="{StaticResource MutedText}" FontSize="12"/>
    </StackPanel>
    <StackPanel Visibility="{Binding IsEnumeration,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Allowed Choices" Margin="0,8,0,4"/><TextBlock Text="Separate values with |, for example Low|Medium|High. Empty and duplicate values are invalid." Style="{StaticResource MutedText}" FontSize="12"/><TextBox Text="{Binding Choices,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Variable allowed choices"/><TextBlock Text="{Binding ChoicesError}" Style="{StaticResource FieldIssue}"/></StackPanel>
    <TextBlock Text="{Binding InactiveMetadataNotice}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8"/><Button Content="Clear incompatible metadata" Command="{Binding ClearIncompatibleCommand}" Visibility="{Binding CanClearIncompatible,Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" FontSize="12"/>
    <TextBlock Text="Effect when increasing/decreasing (user supplied)"/><TextBox Text="{Binding Direction}" TextWrapping="Wrap"/>
    <TextBlock Text="Example Value (Optional)" Margin="0,12,0,4"/><TextBlock Text="An example of a valid value. Used for reference only." Style="{StaticResource MutedText}" FontSize="12"/><TextBox Text="{Binding Example,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Variable example"/><TextBlock Text="{Binding ExampleError}" Style="{StaticResource FieldIssue}"/>
    <TextBlock Text="User-Defined Default (Optional)" Margin="0,10,0,4"/><TextBlock Text="Your preferred default value. This does not establish the game's actual default." Style="{StaticResource MutedText}" FontSize="12"/><TextBox Text="{Binding Default,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Variable default"/><TextBlock Text="{Binding DefaultError}" Style="{StaticResource FieldIssue}"/>
    <TextBlock Text="Neither annotation changes the saved or draft value. Keep secrets out of metadata." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,10"/>
    <TextBlock Text="Restart requirements (unverified unless documented)"/><TextBox Text="{Binding Restart}"/><CheckBox Content="Requires matching client configuration (user supplied)" IsChecked="{Binding ClientRequired}"/>
    <TextBlock Text="Personal notes (no credentials or active secret values)"/><TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="100" VerticalScrollBarVisibility="Auto"/>
    <Button Content="Reset fields to built-in metadata" Command="{Binding ResetBuiltInCommand}" HorizontalAlignment="Left"/>
   </StackPanel></Expander>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding PreviewCaption}" FontSize="12" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Preview,Mode=OneWay}" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Variable INI preview"/><TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxHeight="70" AutomationProperties.LiveSetting="Polite"/><WrapPanel HorizontalAlignment="Right"><Button Content="Go to first issue" Command="{Binding FocusIssueCommand}" Visibility="{Binding HasIssues,Converter={StaticResource BoolVisibility}}" FontSize="12"/><Button Content="Cancel" IsCancel="True" Click="CancelClicked"/><Button Content="{Binding AcceptCaption}" Command="{Binding AcceptCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Confirm variable definition"/></WrapPanel></StackPanel>
 </Grid>
</Window>
