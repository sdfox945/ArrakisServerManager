<Window x:Class="Arrakis.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Arrakis.Desktop.Views" Title="Arrakis Server Manager" Width="1360" Height="860" MinWidth="1040" MinHeight="700" WindowStartupLocation="CenterScreen" Icon="Assets/arrakis.ico" Style="{StaticResource {x:Type Window}}">
 <Window.InputBindings><KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}"/><KeyBinding Key="S" Modifiers="Control" Command="{Binding Editor.SaveCommand}"/></Window.InputBindings>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#15191B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="24,26,20,26"><TextBlock Text="◈  ARRAKIS" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="SERVER MANAGER" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="1,5,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="20"><Border Background="#30291E" CornerRadius="5" Padding="10"><TextBlock Text="{Binding ModeLabel}" FontSize="11" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/></Border><CheckBox Content="Demo mode" IsChecked="{Binding IsDemo}" IsEnabled="{Binding CanOperate}" ToolTip="Simulated infrastructure. No live server connections or mutations."/><TextBlock Text="v1.0.2 · Windows x64" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
   <ListBox ItemsSource="{Binding Pages}" SelectedIndex="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" Margin="10,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="12,14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Nav" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="#342D22"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="#292D2E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="28" FontSize="17"/><TextBlock Text="{Binding Title}" FontSize="13" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="26,22,16,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,10,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="↻  Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid>
   <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedPage}" Padding="0" BorderThickness="0"><TabControl.ItemContainerStyle><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.ItemContainerStyle><TabItem><views:DashboardView/></TabItem><TabItem><views:MapsView/></TabItem><TabItem><views:ConfigurationView/></TabItem><TabItem><views:BackupsView/></TabItem><TabItem><views:DiagnosticsView/></TabItem><TabItem><views:ToolsView/></TabItem></TabControl>
   <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,10,12" Margin="0,12,0,0"><StackPanel><ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" Height="3" Margin="0,0,0,10"/><DockPanel><Button DockPanel.Dock="Right" Content="Cancel read" Command="{Binding CancelCommand}" Visibility="{Binding CanCancel,Converter={StaticResource BoolVisibility}}" Margin="10,0,0,0"/><TextBlock DockPanel.Dock="Right" Text="{Binding OperationState}" Foreground="{StaticResource AccentBrush}" Margin="10,0"/><TextBlock Text="{Binding ConnectionState}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text=" · VM " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding VmState}"/><TextBlock Text=" · Battlegroup " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding BattlegroupState}"/></DockPanel><TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" MaxHeight="52"/></StackPanel></Border>
  </Grid>
 </Grid>
</Window>
