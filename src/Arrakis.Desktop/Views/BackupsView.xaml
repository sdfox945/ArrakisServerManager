<UserControl x:Class="Arrakis.Desktop.Views.BackupsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{StaticResource TextBrush}">
 <Grid Margin="0,0,10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{Binding BackupSummary}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="{Binding CloudBackupWarning}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,12"/><WrapPanel><Button Content="Create database backup" Command="{Binding CreateBackupCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Refresh list" Command="{Binding RefreshBackupsCommand}"/><Button Content="Open backup folder" Command="{Binding OpenBackupsCommand}"/><ComboBox ItemsSource="{Binding BackupCategories}" SelectedItem="{Binding BackupCategory}" Width="180"/></WrapPanel><TextBlock Text="Database backups use Funcom's official workflow. Configuration copies are encrypted for your Windows account. Diagnostic bundles are a separate category." Style="{StaticResource MutedText}" Margin="0,6,0,16"/></StackPanel>
  <Grid Grid.Row="1"><DataGrid ItemsSource="{Binding BackupsView}" SelectedItem="{Binding SelectedBackup}" AutomationProperties.Name="Available backup artifacts"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="125"/><DataGridTextColumn Header="Modified" Binding="{Binding Modified,StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="155"/><DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="95"/></DataGrid.Columns></DataGrid><TextBlock Text="No matching backup artifacts. Refresh the list or create a database backup." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False" Foreground="{StaticResource MutedBrush}" Visibility="{Binding BackupsView.IsEmpty,Converter={StaticResource BoolVisibility}}"/></Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="{Binding SelectedBackup.Path}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedBackup.Path}"/><WrapPanel Margin="0,12,0,0"><Button Content="Download selected database backup" Command="{Binding DownloadBackupCommand}"/><Button Content="Restore selected database backup…" Command="{Binding ImportCommand}" Style="{StaticResource DangerButton}"/></WrapPanel><TextBlock Text="Restore overwrites database progress. The battlegroup must already be Stopped. Configuration backups are restored through Server Configuration → Restore backup → Review &amp; Save. No automatic restore is ever performed." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border>
 </Grid>
</UserControl>
