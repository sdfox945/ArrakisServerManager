<UserControl x:Class="Arrakis.Desktop.Views.ToolsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{StaticResource TextBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Arrakis application updates" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ApplicationUpdates.InstalledCaption}"/><TextBlock Text="Checks GitHub for this Windows application. Funcom server software updates remain separate below." Style="{StaticResource MutedText}"/><CheckBox Content="Automatically check GitHub for Arrakis updates" IsChecked="{Binding ApplicationUpdates.AutomaticChecksEnabled}" Margin="0,10"/><WrapPanel><Button Content="Check for application updates" Command="{Binding ApplicationUpdates.CheckCommand}"/><Button Content="Application update details…" Click="ApplicationUpdateClicked"/></WrapPanel><TextBlock Text="{Binding ApplicationUpdates.StatusMessage}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding ApplicationUpdates.LastCheckCaption}" Style="{StaticResource MutedText}"/><StackPanel Visibility="{Binding IsDemo,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Simulated application-update scenario" Margin="0,10,0,2"/><ComboBox ItemsSource="{Binding ApplicationUpdates.Scenarios}" SelectedItem="{Binding ApplicationUpdates.Scenario}" IsEnabled="{Binding ApplicationUpdates.CanChangeScenario}" AutomationProperties.Name="Demo application update scenario"/><TextBlock Text="No real GitHub requests or software downloads are made in Demo. Verified fixtures contain only inert text." Style="{StaticResource MutedText}"/></StackPanel></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding AdminStatus}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/><TextBlock Text="Connection &amp; discovery" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Steam server directory" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Preferences.InstallationDirectory,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="Browse" Command="{Binding BrowseInstallationCommand}"/><TextBlock Grid.Row="1" Text="Hyper-V VM name" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Preferences.VmName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="2" Text="Existing SSH key" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Preferences.SshKeyPath,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Row="2" Grid.Column="2" Content="Browse" Command="{Binding BrowseKeyCommand}"/><TextBlock Grid.Row="3" Text="VM IPv4 override" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Preferences.ManualIp,UpdateSourceTrigger=PropertyChanged}" ToolTip="Leave empty for Hyper-V discovery. When Hyper-V access is denied, a recent Funcom management-log address is used as a fallback."/></Grid><TextBlock Text="{Binding VmAdapter}" Style="{StaticResource MutedText}"/><TextBlock Text="SSH account: dune · port 22 · strict host identity verification · existing key only" Style="{StaticResource MutedText}" Margin="0,7,0,14"/><WrapPanel><Button Content="Review new host fingerprint" Command="{Binding TrustHostCommand}"/><Button Content="Read Hyper-V details with UAC" Command="{Binding ElevatedVmReadCommand}"/></WrapPanel><TextBlock Text="For automatic VM discovery without elevating the GUI, your Windows account needs Hyper-V permissions. The included Launch as Administrator.cmd requests UAC for the whole Live manager; Demo can run without elevation. The UAC action elevates only a read-only snapshot. New SSH identities require independent fingerprint verification; changed pins are rejected." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Monitoring &amp; local storage" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Refresh interval (sec)" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Preferences.RefreshSeconds,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="1" Text="Low host RAM (GiB)" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Preferences.LowHostAvailableGb,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="2" Text="Guest RAM warning (%)" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Preferences.GuestMemoryWarningPercent,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="3" Text="Swap warning (%)" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Preferences.SwapWarningPercent,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="4" Text="Backup directory" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Preferences.BackupDirectory,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Row="4" Grid.Column="2" Content="Browse" Command="{Binding BrowseBackupCommand}"/><TextBlock Grid.Row="5" Text="Log export directory" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Preferences.LogDirectory,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Row="5" Grid.Column="2" Content="Browse" Command="{Binding BrowseLogsCommand}"/></Grid><Button Content="Save connection &amp; preferences" Command="{Binding SavePreferencesCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/><TextBlock Text="Demo backups and exports are isolated under the application's Demo data directory. Configuration backups use Windows DPAPI and can only be decrypted by this Windows user." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Server tools" Style="{StaticResource SectionTitle}"/><WrapPanel><Button Content="Open Director ↗" Command="{Binding OpenDirectorCommand}"/><Button Content="Open File Browser ↗" Command="{Binding OpenFileBrowserCommand}"/><Button Content="Start VM" Command="{Binding StartVmCommand}"/><Button Content="Gracefully shut down VM" Command="{Binding ShutdownVmCommand}"/></WrapPanel><TextBlock Text="Director's NodePort is discovered from service port 11717. Both web tools are checked for availability before opening. Swap status appears on the Dashboard; enabling experimental swap is reserved for Funcom's maintenance tools." Style="{StaticResource MutedText}"/></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Server updates" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding UpdateInformation}" Style="{StaticResource MutedText}"/><WrapPanel Margin="0,14,0,0"><Button Content="Check downloaded revision" Command="{Binding CheckUpdatesCommand}"/><Button Content="Download &amp; apply updates…" Command="{Binding UpdateCommand}" Style="{StaticResource DangerButton}"/></WrapPanel></StackPanel></Border>
  <Border Style="{StaticResource Card}" BorderBrush="#71504A"><StackPanel><TextBlock Text="Use acknowledgment only after inspecting the prior operation details and independently verifying its affected file or server state. It permits new mutations; it does not repair, roll back, or prove the earlier operation succeeded. Never acknowledge merely to dismiss an error." Style="{StaticResource MutedText}" Margin="0,0,0,12"/><TextBlock Text="Advanced recovery" Style="{StaticResource SectionTitle}" Foreground="{StaticResource DangerBrush}"/><WrapPanel><Button Content="Emergency force power-off…" Command="{Binding ForceOffVmCommand}" Style="{StaticResource DangerButton}"/><Button Content="Acknowledge reviewed unknown outcome…" Command="{Binding ReconcileCommand}"/></WrapPanel><WrapPanel><Button Content="VM networking console…" Command="{Binding NetworkConsoleCommand}"/><Button Content="Password console…" Command="{Binding PasswordConsoleCommand}"/><Button Content="Experimental swap console…" Command="{Binding SwapConsoleCommand}" Style="{StaticResource DangerButton}"/></WrapPanel><TextBlock Text="Forced power-off can lose or corrupt data. Graceful shutdown is the routine control. Networking and experimental swap use Funcom's console; passwords use native Linux passwd. Additional prompts appear there. SSH key rotation remains in the official Windows tools because their replacement and recovery behavior requires a security review. Reinstall and initial setup are excluded." Style="{StaticResource MutedText}"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Visibility="{Binding IsDemo,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Simulated infrastructure" Style="{StaticResource SectionTitle}"/><ComboBox ItemsSource="{Binding DemoScenarios}" SelectedItem="{Binding DemoScenario}"/><TextBlock Text="Try an offline VM, allocating map, OOM kill, failed SSH or failed configuration save. Every value and operation in this mode is simulated. Switching modes discards loaded server data." Style="{StaticResource MutedText}"/></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Copy output" Command="{Binding CopyOutputCommand}"/><TextBlock Text="Latest operation output" Style="{StaticResource SectionTitle}"/></DockPanel><TextBox Text="{Binding OperationOutput,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Height="170"/></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
