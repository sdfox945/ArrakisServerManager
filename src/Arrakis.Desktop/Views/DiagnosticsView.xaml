<UserControl x:Class="Arrakis.Desktop.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{StaticResource TextBrush}">
 <Grid Margin="0,0,10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <WrapPanel><ComboBox ItemsSource="{Binding LogSources}" SelectedItem="{Binding LogSource}" Width="200"/><Button Content="Read logs" Command="{Binding LoadLogsCommand}"/><CheckBox Content="Live tail" IsChecked="{Binding LiveLogs}" ToolTip="Retrieve a bounded tail at the refresh interval while this page is open."/><TextBox Text="{Binding LogSearch,UpdateSourceTrigger=PropertyChanged}" Width="180" ToolTip="Filter displayed lines" AutomationProperties.Name="Search logs"/><Button Content="Copy filtered logs" Command="{Binding CopyLogsCommand}"/></WrapPanel>
  <TabControl Grid.Row="1" x:Name="DiagnosticTabs"><TabItem Header="Log viewer"><TextBox Text="{Binding FilteredLogs,Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,14,0,0" AutomationProperties.Name="Log content"/></TabItem>
   <TabItem Header="Kubernetes events"><DataGrid ItemsSource="{Binding Events}" Margin="0,14,0,0"><DataGrid.Columns><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="150"/><DataGridTextColumn Header="Object" Binding="{Binding Object}" Width="200"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Operation history"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="240"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" AutomationProperties.Name="Operation history"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Timestamp,StringFormat={}{0:MM-dd HH:mm:ss}}" Width="130"/><DataGridTextColumn Header="Operation" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="150"/><DataGridTextColumn Header="Summary" Binding="{Binding Output}" Width="2*"/></DataGrid.Columns></DataGrid><Grid Grid.Row="1" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="Copy selected diagnostic details" Command="{Binding CopyHistoryCommand}"/><TextBlock Text="Selected operation • full diagnostic details" VerticalAlignment="Center"/></DockPanel><TextBox Grid.Row="1" Text="{Binding SelectedHistoryDetails,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Selected operation details"/></Grid></Grid></TabItem>
   <TabItem Header="Export &amp; health"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,0,0"><TextBlock Text="Health checks" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding HealthSummary}" TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,18"/><ItemsControl ItemsSource="{Binding Warnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,10"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel Margin="0,20,0,0"><Button Content="Export complete diagnostic bundle" Command="{Binding ExportDiagnosticsCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Export battlegroup logs" Command="{Binding ExportBgCommand}"/><Button Content="Export operator logs" Command="{Binding ExportOperatorCommand}"/><Button Content="Open exports" Command="{Binding OpenLogsCommand}"/></WrapPanel><TextBlock Text="The bundle includes available status, application history, and both official log archives. Inspect archives before sharing; they may contain sensitive server information." Style="{StaticResource MutedText}"/><TextBox Text="{Binding OperationOutput,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="220" Margin="0,16,0,0"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</UserControl>
