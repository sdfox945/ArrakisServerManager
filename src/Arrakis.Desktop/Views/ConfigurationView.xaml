<UserControl x:Class="Arrakis.Desktop.Views.ConfigurationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{StaticResource TextBrush}">
 <Grid DataContext="{Binding Editor}" IsEnabled="{Binding CanInteract}" Margin="0,0,10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><WrapPanel><Button Content="Load current configuration" Command="{Binding LoadCommand}"/><ComboBox x:Name="FilePicker" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile,Mode=OneWay}" IsSynchronizedWithCurrentItem="False" DropDownOpened="FilePickerOpened" DropDownClosed="FilePickerClosed" SelectionChanged="FilePickerChanged" PreviewKeyDown="FilePickerKeyDown" Width="260"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="Preview diff" Command="{Binding PreviewCommand}"/><Button Content="Undo draft" Command="{Binding UndoCommand}"/><Button Content="Restore backup" Command="{Binding RestoreCommand}"/></WrapPanel><TextBlock Text="{Binding FilePath}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,10"/></StackPanel>
  <TabControl Grid.Row="1" x:Name="EditorModes"><TabItem Header="Visual Settings Editor"><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions><Grid Margin="0,0,18,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search setting name, INI key or description" AutomationProperties.Name="Search settings"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding SettingsView}" SelectedItem="{Binding SelectedSetting}" AutomationProperties.Name="Known configuration settings"><DataGrid.Columns><DataGridTextColumn Header="Setting" Binding="{Binding Definition.Name}" Width="*"/><DataGridTextColumn Header="Current draft" Binding="{Binding Current}" Width="140"/></DataGrid.Columns></DataGrid></Grid><Border Grid.Column="1" Style="{StaticResource Card}" Margin="0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding SelectedSetting.Definition.Name}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/><TextBlock Text="{Binding SettingDetails}" Style="{StaticResource MutedText}" LineHeight="22"/><TextBlock Text="Proposed value" Margin="0,20,0,8"/><TextBox Text="{Binding SettingValue,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding HasNumericValue,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Proposed setting value"/><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SettingValue}" Visibility="{Binding HasChoices,Converter={StaticResource BoolVisibility}}"/><Button Content="Add to draft" Command="{Binding ApplySettingCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Reset verified default" Command="{Binding ResetCommand}" Visibility="{Binding HasVerifiedDefault,Converter={StaticResource BoolVisibility}}" ToolTip="Enabled only when an engine default has been independently verified; template values are not engine defaults."/><TextBlock Text="Documented settings come from the installed Funcom templates. Unknown defaults and effects are labeled. Review the raw file for additional keys." Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0"/></StackPanel></ScrollViewer></Border></Grid></TabItem>
   <TabItem Header="Raw INI Editor"><DockPanel><Button DockPanel.Dock="Top" Content="Review raw removals" Command="{Binding ReviewRemovalsCommand}" HorizontalAlignment="Left" ToolTip="Removing existing keys, sections or comments requires a separate filename confirmation before final save."/><TextBox x:Name="RawEditor" Text="{Binding RawText,Mode=OneWay}" TextChanged="RawEditorChanged" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0" AutomationProperties.Name="Raw INI text"/></DockPanel></TabItem>
  </TabControl>
  <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Review &amp; save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="14,0,0,0"/><StackPanel><TextBlock Text="{Binding DraftState}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Validation}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" MaxHeight="80" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
 </Grid>
</UserControl>
