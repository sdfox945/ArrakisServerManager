<UserControl x:Class="Arrakis.Desktop.Views.ConfigurationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Arrakis.Desktop.Controls" Foreground="{StaticResource TextBrush}">
 <Grid DataContext="{Binding Editor}" IsEnabled="{Binding CanInteract}" Margin="0,0,10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><WrapPanel><Button Content="Load current configuration" Padding="8,6" Command="{Binding LoadCommand}"/><ComboBox x:Name="FilePicker" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile,Mode=OneWay}" IsSynchronizedWithCurrentItem="False" DropDownOpened="FilePickerOpened" DropDownClosed="FilePickerClosed" SelectionChanged="FilePickerChanged" PreviewKeyDown="FilePickerKeyDown" ToolTip="{Binding SelectedFile.Name}" Width="245"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="Preview diff" Padding="8,6" Command="{Binding PreviewCommand}"/><Button Content="Undo draft" Padding="8,6" Command="{Binding UndoCommand}"/><Button Content="Restore backup" Padding="8,6" Command="{Binding RestoreCommand}"/></WrapPanel><DockPanel Margin="0,4,0,10"><Button DockPanel.Dock="Right" Content="Copy path" Margin="0" Command="{Binding CopyPathCommand}" Padding="8,3" MinHeight="28"/><TextBlock Text="{Binding FileCaption}" ToolTip="{Binding FilePath}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></StackPanel>
  <TabControl Grid.Row="1" x:Name="EditorModes"><TabItem Header="Visual Settings Editor"><Grid x:Name="VisualSplit" Margin="0,14,0,0" Loaded="SplitLoaded" SizeChanged="SplitSized"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="8"/><ColumnDefinition x:Name="DetailsColumn" Width="440" MinWidth="280"/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="SettingsPaneScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,8,0"><Grid x:Name="SettingsPane" Height="{Binding ActualHeight,ElementName=VisualSplit}" MinHeight="340"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><WrapPanel><Button Content="Add Variable" Click="AddVariableClicked" IsEnabled="{Binding CanManageMetadata}" Style="{StaticResource PrimaryButton}"/><Button Content="Import definitions" Click="ImportClicked" IsEnabled="{Binding CanManageMetadata}" Padding="8,4"/><Button Content="Export definitions" Click="ExportClicked" Padding="8,4"/><Button Content="Demo examples" Click="DemoDefinitionsClicked" Padding="8,4" IsEnabled="{Binding CanManageMetadata}" Visibility="{Binding IsDemoCatalog,Converter={StaticResource BoolVisibility}}"/></WrapPanel>
    <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Tag="Search name, key, section or category…" ToolTip="Search name, INI key, category or description" AutomationProperties.Name="Search settings"/>
    <ComboBox x:Name="CategoryPicker" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Configuration category"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <CheckBox Content="Include supported settings available to add" IsChecked="{Binding ShowAvailableToAdd}" FontSize="12" ToolTip="Available entries are not configured yet. Only Add to draft inserts a setting."/>
   </StackPanel><Grid Grid.Row="1"><DataGrid ItemsSource="{Binding SettingsView}" SelectedItem="{Binding SelectedSetting}" AutomationProperties.Name="Configuration settings" FontSize="12"><DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="6,0"/></Style></DataGrid.CellStyle><DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="6,8"/></Style></DataGrid.ColumnHeaderStyle><DataGrid.Resources><Style x:Key="SettingCellText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/></Style></DataGrid.Resources><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Definition.Details}"/></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource SettingCellText}" Header="Setting" Binding="{Binding Definition.Name}" Width="2*"/><DataGridTextColumn ElementStyle="{StaticResource SettingCellText}" Header="Saved" Binding="{Binding DisplaySaved}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource SettingCellText}" Header="Draft" Binding="{Binding DisplayCurrent}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource SettingCellText}" Header="State" Binding="{Binding State}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource SettingCellText}" Header="Source" Binding="{Binding Source}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="No settings match. Clear the search, choose All categories, or include settings available to add." TextWrapping="Wrap" IsHitTestVisible="False" Margin="22" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Visibility="{Binding SettingsView.IsEmpty,Converter={StaticResource BoolVisibility}}"/></Grid></Grid></ScrollViewer>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" DragCompleted="SplitDragged" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Setting details pane divider"/><Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{Binding SelectedSetting.Definition.Name}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/><TextBlock Text="{Binding SettingDetails}" Style="{StaticResource MutedText}" LineHeight="20" FontSize="13"/>
    <TextBlock Text="{Binding SelectedSetting.Source}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,6"/><TextBlock Text="{Binding ValueComparison}" Margin="0,12,0,4" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource AccentBrush}"/>
    <TextBlock Text="Proposed value" Margin="0,10,0,8"/><TextBox Text="{Binding SettingValue,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding HasNumericValue,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Proposed setting value"/>
    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SettingValue}" Visibility="{Binding HasChoices,Converter={StaticResource BoolVisibility}}"/>
    <StackPanel Visibility="{Binding HasSlider,Converter={StaticResource BoolVisibility}}"><controls:ProposalSlider x:Name="ValueSlider" Minimum="{Binding SliderMinimum}" Maximum="{Binding SliderMaximum}" SmallChange="{Binding SliderIncrement}" LargeChange="{Binding SliderIncrement}" TickFrequency="{Binding SliderIncrement}" IsSnapToTickEnabled="False" Value="{Binding SliderValue,Mode=OneWay}" ValueChosen="SliderChosen" Foreground="{StaticResource AccentBrush}" Margin="0,8,4,10" AutomationProperties.Name="Proposed numerical value slider"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding SliderMinimumLabel}" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding SliderMaximumLabel}" TextAlignment="Right" Style="{StaticResource MutedText}" FontSize="12"/></Grid></StackPanel>
    <TextBlock Text="{Binding AcceptedValues}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6"/><TextBlock Text="{Binding NumericValidation}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,6"/>
    <TextBlock Text="{Binding SelectedSetting.Definition.Direction}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6"/><Button Content="Add to draft" Command="{Binding ApplySettingCommand}" Style="{StaticResource PrimaryButton}"/><WrapPanel><Button Content="Copy key" Click="CopyKeyClicked" Padding="8,4"/><Button Content="Manage definition" Click="ManageClicked" IsEnabled="{Binding CanManageMetadata}" Padding="8,4"/><Button Content="Remove Definition" Click="RemoveClicked" IsEnabled="{Binding CanManageMetadata}" Padding="8,4"/></WrapPanel><Button Content="Reset User Default" Command="{Binding ResetUserDefaultCommand}" Visibility="{Binding HasUserDefault,Converter={StaticResource BoolVisibility}}" ToolTip="Use your metadata default as a proposal only. Add to draft and review are still required."/><Button Content="{Binding ResetDefaultCaption}" Command="{Binding ResetCommand}" Visibility="{Binding HasVerifiedDefault,Converter={StaticResource BoolVisibility}}"/>
    <Expander Header="Technical identity, bounds and documentation" Margin="0,8"><TextBlock Text="{Binding SelectedSetting.Definition.Details}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8"/></Expander>
    <TextBlock Text="Adjusting a proposed value does not change the draft until Add to draft. Unknown defaults are not guessed. Review the complete diff before saving." Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0"/>
   </StackPanel></ScrollViewer></Border></Grid></TabItem>
   <TabItem Header="Raw INI Editor"><DockPanel><Button DockPanel.Dock="Top" Content="Review raw removals" Command="{Binding ReviewRemovalsCommand}" HorizontalAlignment="Left" ToolTip="Removing existing keys, sections or comments requires a separate filename confirmation before final save."/><TextBox x:Name="RawEditor" Text="{Binding RawText,Mode=OneWay}" TextChanged="RawEditorChanged" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0" AutomationProperties.Name="Raw INI text"/></DockPanel></TabItem>
  </TabControl>
  <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Review &amp; save" Command="{Binding SaveCommand}" VerticalAlignment="Center" MaxHeight="44" Style="{StaticResource PrimaryButton}" Margin="14,0,0,0"/><StackPanel><TextBlock Text="{Binding DraftState}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding MetadataStatus}" Style="{StaticResource MutedText}" FontSize="11"/><Button Content="Reload metadata" Click="ReloadMetadataClicked" HorizontalAlignment="Left" Padding="6,2" MinHeight="24" FontSize="11"/><TextBlock Text="{Binding Validation}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" MaxHeight="80" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
 </Grid>
</UserControl>
