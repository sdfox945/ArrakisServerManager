<UserControl x:Class="Arrakis.Desktop.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{StaticResource TextBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <UniformGrid Columns="2">
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WINDOWS HOST" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding HostRam}" Style="{StaticResource Metric}" FontSize="22"/><ProgressBar Value="{Binding HostRamPercent,Mode=OneWay}"/><TextBlock Text="{Binding HostAvailable}" Style="{StaticResource MutedText}"/><DockPanel Margin="0,12,0,0"><TextBlock Text="CPU" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding HostCpu}" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding ClientState}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="HYPER-V VIRTUAL MACHINE" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding VmState}" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding VmName}" Style="{StaticResource Metric}" FontSize="22"/><ProgressBar Value="{Binding VmRamPercent,Mode=OneWay}" ToolTip="Reported memory demand / assigned memory; unavailable demand is shown as an empty bar."/><TextBlock Text="{Binding VmMemory}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding VmAddress}" Margin="0,12,0,0"/><DockPanel Margin="0,8,0,0"><TextBlock Text="Uptime" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding VmUptime}" HorizontalAlignment="Right"/></DockPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LINUX GUEST" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding GuestRam}" Style="{StaticResource Metric}" FontSize="22"/><ProgressBar Value="{Binding GuestRamPercent,Mode=OneWay}"/><TextBlock Text="{Binding GuestAvailable}" Style="{StaticResource MutedText}"/><DockPanel Margin="0,12,0,0"><TextBlock Text="CPU" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding GuestCpu}" HorizontalAlignment="Right"/></DockPanel><DockPanel Margin="0,8,0,0"><TextBlock Text="Swap" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding GuestSwap}" HorizontalAlignment="Right"/></DockPanel><ProgressBar Value="{Binding SwapPercent,Mode=OneWay}"/><TextBlock Text="{Binding GuestDisk}" Style="{StaticResource MutedText}"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="BATTLEGROUP" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding BattlegroupState}" Style="{StaticResource Metric}"/><TextBlock Text="{Binding InstanceSummary}" Style="{StaticResource MutedText}" Margin="0,7,0,10"/><TextBlock Text="{Binding Revision}" Style="{StaticResource MutedText}"/><WrapPanel Margin="0,20,0,0"><Button Content="▶  Start" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Stop" Command="{Binding StopCommand}"/><Button Content="Restart" Command="{Binding RestartCommand}"/></WrapPanel><TextBlock Text="Lifecycle changes always require confirmation." FontSize="12" Style="{StaticResource MutedText}"/></StackPanel></Border>
  </UniformGrid>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Health &amp; resource warnings" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding Warnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#D5C8B3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Only available measurements are evaluated. Unknown metrics are never estimated." Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
