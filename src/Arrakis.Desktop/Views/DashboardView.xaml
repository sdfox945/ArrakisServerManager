<UserControl x:Class="Arrakis.Desktop.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Arrakis.Desktop.Controls" Foreground="{StaticResource TextBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <TextBlock Text="{Binding RefreshState}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
  <UniformGrid Columns="2">
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WINDOWS HOST" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding HostRam}" Style="{StaticResource Metric}" FontSize="21"/><ProgressBar Value="{Binding HostRamPercent,Mode=OneWay}"/><TextBlock Text="{Binding HostAvailable}" Style="{StaticResource MutedText}"/><DockPanel Margin="0,10,0,0"><TextBlock Text="CPU"/><TextBlock Text="{Binding HostCpu}" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding ClientState}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/><TextBlock Text="Guest RAM is already included in Windows host usage." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="HYPER-V VIRTUAL MACHINE" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding VmName}" Style="{StaticResource Metric}" FontSize="21"/><TextBlock Text="{Binding VmAccess}" ToolTip="{Binding VmTechnicalDetails}" Style="{StaticResource MutedText}"/><ProgressBar Value="{Binding VmRamPercent,Mode=OneWay}" ToolTip="Reported demand / assigned memory; an unavailable measurement is an empty bar."/><TextBlock Text="{Binding VmMemory}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding VmAddress}" Margin="0,8,0,0"/><TextBlock Text="{Binding VmUptime,StringFormat=Uptime: {0}}" Style="{StaticResource MutedText}" Margin="0,5,0,8"/><WrapPanel><Button Content="Start VM" Command="{Binding StartVmCommand}"/><Button Content="Graceful shutdown…" Command="{Binding ShutdownVmCommand}"/><Button Content="Refresh VM" Command="{Binding RefreshCommand}"/></WrapPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LINUX GUEST" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding GuestRam}" Style="{StaticResource Metric}" FontSize="21"/><ProgressBar Value="{Binding GuestRamPercent,Mode=OneWay}"/><TextBlock Text="{Binding GuestAvailable}" Style="{StaticResource MutedText}"/><DockPanel Margin="0,10,0,0"><TextBlock Text="CPU"/><TextBlock Text="{Binding GuestCpu}" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding GuestSwap,StringFormat=Swap: {0}}" Margin="0,8,0,0"/><ProgressBar Value="{Binding SwapPercent,Mode=OneWay}"/><TextBlock Text="{Binding GuestDisk}" Style="{StaticResource MutedText}"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="BATTLEGROUP" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding BattlegroupState}" Style="{StaticResource Metric}" FontSize="21" TextWrapping="Wrap"/><TextBlock Text="{Binding InstanceSummary}" Style="{StaticResource MutedText}" Margin="0,7,0,10"/><TextBlock Text="{Binding Revision}" Style="{StaticResource MutedText}"/><WrapPanel Margin="0,14,0,0"><Button Content="▶  Start" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Stop" Command="{Binding StopCommand}"/><Button Content="Restart" Command="{Binding RestartCommand}"/></WrapPanel><TextBlock Text="Lifecycle changes require confirmation. Unavailable states never imply Stopped." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border>
  </UniformGrid>
  <Border Style="{StaticResource Card}"><StackPanel><DockPanel><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding HistoryWindows}" SelectedItem="{Binding HistoryMinutes}" Width="90" AutomationProperties.Name="History window minutes"/><TextBlock Text="Recent resource usage (%)" Style="{StaticResource SectionTitle}"/></DockPanel><TextBlock Text="{Binding HistoryCaption}" Style="{StaticResource MutedText}" FontSize="12"/><UniformGrid Columns="3" Margin="0,12,0,0"><StackPanel Margin="0,0,12,0"><TextBlock Text="Host RAM"/><controls:ResourceChart Samples="{Binding HistorySamples}" Minutes="{Binding HistoryMinutes}" Metric="Host" Height="100" AutomationProperties.Name="Host RAM percentage history"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Guest RAM"/><controls:ResourceChart Samples="{Binding HistorySamples}" Minutes="{Binding HistoryMinutes}" Metric="Guest" Height="100" AutomationProperties.Name="Guest RAM percentage history"/></StackPanel><StackPanel><TextBlock Text="Swap"/><controls:ResourceChart Samples="{Binding HistorySamples}" Minutes="{Binding HistoryMinutes}" Metric="Swap" Height="100" AutomationProperties.Name="Swap percentage history"/></StackPanel></UniformGrid></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Health &amp; resource warnings" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding NoticeSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Notices}"><ItemsControl.ItemTemplate><DataTemplate><Button Click="NoticeClicked" HorizontalContentAlignment="Stretch" ToolTip="Open the affected instance or diagnostics"><StackPanel><TextBlock Text="{Binding Heading}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding Investigation}" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Only available measurements are evaluated. Configured limits are not actual memory usage. Full historical events remain in Diagnostics." Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
