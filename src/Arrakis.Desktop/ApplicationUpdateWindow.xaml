<Window x:Class="Arrakis.Desktop.ApplicationUpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Arrakis application update" Width="800" Height="700" MinWidth="640" MinHeight="560" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
 <Grid x:Name="DialogLayout" Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel x:Name="ReleaseSummary" Margin="0,0,0,12" AutomationProperties.Name="Fixed application release summary">
   <TextBlock Text="Arrakis application update" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock Text="For Arrakis only — Funcom server updates are separate." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,10"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Installed application" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{Binding InstalledCaption}" FontSize="14" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="Latest published release" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{Binding LatestSummaryVersion}" ToolTip="{Binding LatestVersion}" FontSize="14" TextWrapping="Wrap"/></StackPanel></Grid>
   <TextBlock x:Name="AvailabilityStatus" Text="{Binding SummaryStatus}" ToolTip="{Binding FooterTooltip}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="13" Margin="0,8,0,0" AutomationProperties.Name="Application update availability"/>
  </StackPanel>
  <Border x:Name="ReleaseInformation" Grid.Row="1" MaxHeight="300" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10"><ScrollViewer x:Name="ReleaseInfoScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="280" AutomationProperties.Name="Scrollable release information"><StackPanel>
   <TextBlock Text="{Binding ReleaseName}" ToolTip="{Binding ReleaseName}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding PublishedDate}" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock Text="{Binding AssetCaption}" ToolTip="{Binding AssetCaption}" TextWrapping="Wrap" FontSize="12" Visibility="{Binding HasUpdate,Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0"/><TextBlock Text="Release notes · plain text" FontSize="12" Style="{StaticResource MutedText}" Margin="0,8,0,4"/>
   <TextBox x:Name="ReleaseNotesBox" Text="{Binding ReleaseNotes,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" MinHeight="0" Margin="0" Padding="0" BorderThickness="0" Background="Transparent" FontSize="12" AutomationProperties.Name="Application release notes"/>
  </StackPanel></ScrollViewer></Border>
  <Border x:Name="OperationArea" Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" AutomationProperties.Name="Fixed download and verification area"><StackPanel>
   <TextBlock x:Name="LocalActionError" Text="{Binding ActionErrorMessage}" ToolTip="{Binding StatusMessage}" Visibility="{Binding HasActionError,Converter={StaticResource BoolVisibility}}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,0,0,8" AutomationProperties.Name="Update local action error"/>
   <StackPanel x:Name="DownloadArea" Visibility="{Binding ShowDownloadArea,Converter={StaticResource BoolVisibility}}">
    <TextBlock x:Name="DownloadStatus" Text="{Binding DownloadStatusCaption}" ToolTip="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.Name="Application verification status" AutomationProperties.LiveSetting="Polite"/>
    <StackPanel x:Name="DestinationArea" Visibility="{Binding ShowDestination,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Download destination" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DestinationPath" Text="{Binding DownloadDirectory,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DownloadDirectory}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="36" MaxHeight="48" Margin="0" FontSize="12" AutomationProperties.Name="Application update destination"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsDownloading}" Value="True"><Setter Property="IsReadOnly" Value="True"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><Button Grid.Column="1" Content="Choose folder…" Command="{Binding BrowseDestinationCommand}" Margin="8,0,0,0" MinHeight="36" FontSize="12"/></Grid></StackPanel>
    <StackPanel x:Name="ProgressArea" Visibility="{Binding ShowDownloadProgress,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"><ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Value="{Binding DownloadPercent,Mode=OneWay}" Height="6" Margin="0,0,0,4" AutomationProperties.Name="Application download progress"/><TextBlock Text="{Binding ProgressCaption}" Style="{StaticResource MutedText}" FontSize="12" AutomationProperties.Name="Downloaded bytes and percentage"/></StackPanel>
    <StackPanel x:Name="VerifiedArea" Visibility="{Binding ShowVerifiedFile,Converter={StaticResource BoolVisibility}}"><TextBox x:Name="VerifiedPath" Text="{Binding DownloadPath,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="36" MaxHeight="56" Margin="0,0,0,6" FontSize="12" AutomationProperties.Name="Verified application download path"/><WrapPanel><Button Content="Open Download Folder" Command="{Binding OpenDownloadFolderCommand}" Margin="0,0,8,6" FontSize="12" MinHeight="34"/><Button Content="Copy Download Path" Command="{Binding CopyDownloadPathCommand}" Margin="0,0,8,6" FontSize="12" MinHeight="34"/><Button Content="Choose next folder…" Command="{Binding BrowseDestinationCommand}" ToolTip="{Binding DownloadActionTooltip}" Margin="0,0,0,6" FontSize="12" MinHeight="34"/></WrapPanel><TextBlock Text="{Binding NextDownloadCaption}" ToolTip="{Binding DownloadDirectory}" TextTrimming="CharacterEllipsis" FontSize="11" Style="{StaticResource MutedText}" Margin="0,0,0,6"/></StackPanel>
   </StackPanel>
   <Expander x:Name="DiagnosticsHelp" Header="Technical details" Visibility="{Binding HasDiagnostics,Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource MutedBrush}" FontSize="12" IsExpanded="False" Expanded="DiagnosticsExpanded" Margin="0,0,0,6" AutomationProperties.Name="Update technical details"><Grid x:Name="DiagnosticsContent" Height="80" Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox Text="{Binding TechnicalDetails,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0" FontSize="11" AutomationProperties.Name="Copyable update diagnostics"/><Button Grid.Row="1" Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" MinHeight="28" Padding="8,3" FontSize="11"/></Grid></Expander>
   <Expander x:Name="InstallationHelp" Header="How to install this update" Visibility="{Binding ShowVerifiedFile,Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource MutedBrush}" FontSize="12" IsExpanded="False" Expanded="InstallationExpanded" Margin="0,0,0,6" AutomationProperties.Name="How to install this update"><ScrollViewer x:Name="InstallationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="100" Margin="0,6,0,0"><TextBlock Text="{Binding InstallationInstructions}" TextWrapping="Wrap" FontSize="12" Style="{StaticResource MutedText}"/></ScrollViewer></Expander>
  </StackPanel></Border>
  <WrapPanel x:Name="ActionArea" Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,0,0" AutomationProperties.Name="Fixed update actions"><Button Content="Check for Updates" Command="{Binding CheckCommand}" Visibility="{Binding ShowCheckAction,Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0" FontSize="12"/><Button x:Name="DownloadAction" Content="{Binding DownloadActionText}" Command="{Binding DownloadCommand}" Visibility="{Binding ShowDownloadAction,Converter={StaticResource BoolVisibility}}" ToolTip="{Binding DownloadActionTooltip}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" FontSize="12"/><Button x:Name="CancelDownloadAction" Content="Cancel download" Command="{Binding CancelDownloadCommand}" Visibility="{Binding IsDownloading,Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0" FontSize="12"/><Button Content="View on GitHub" Command="{Binding ViewOnGitHubCommand}" ToolTip="Open the validated official release page. External browsing is unavailable in Demo." Margin="0,0,8,0" FontSize="12"/><Button x:Name="CloseAction" Content="Close" Click="CloseClicked" IsCancel="True" Margin="0" FontSize="12"/></WrapPanel>
 </Grid>
</Window>
