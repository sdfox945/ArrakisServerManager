 <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource RaisedBrush}"/><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,0,8,8"/>
