<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="BackgroundBrush" Color="#111416"/><SolidColorBrush x:Key="PanelBrush" Color="#1A1E21"/><SolidColorBrush x:Key="RaisedBrush" Color="#24292C"/>
